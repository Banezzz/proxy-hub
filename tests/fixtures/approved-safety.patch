+    owner=$(stat -c '%u' "$SSH_ROLLBACK_STATE_DIR" 2>/dev/null) || return 1
+    mode=$(stat -c '%a' "$SSH_ROLLBACK_STATE_DIR" 2>/dev/null) || return 1

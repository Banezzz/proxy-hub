+            CLEANUP_HAS_UNBOUNDED_ROOTS=1
+            return 0
+        fi
+        CLEANUP_TRACKED_GROUPS[$group_id]=1
+        CLEANUP_GROUP_LEADER_IDENTITIES[$group_id]="$leader_identity"

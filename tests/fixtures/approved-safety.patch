+        cleanup_refresh_process_tree || return 1
+        if ! cleanup_tree_has_live_processes; then
+            ((CLEANUP_HAS_UNBOUNDED_ROOTS == 0)) && return 0
+            return 1
+        fi
+        sleep 0.05
+    done
+    return 1
+}

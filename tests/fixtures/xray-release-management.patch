+    xray_revalidate_release_request "$intent" "$XRAY_TXN_TARGET" || intent_rc=$?
+    case "$intent_rc" in
+        0) ;;
+        10) XRAY_TXN_COMMITTED=1; return 0 ;;
+        *) return 1 ;;
+    esac
+
+    bin_dir=$(dirname "$XRAY_BIN")

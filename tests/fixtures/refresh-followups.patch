+# Usage: decrypt_into VARIABLE_NAME
+decrypt_into() {
+    local __dec_name="$1" __dec_cipher="${!1:-}" __dec_plain
+    __dec_plain=$(decrypt_value "$__dec_cipher" 2>/dev/null)
+    if [[ -n "$__dec_cipher" && -z "$__dec_plain" ]]; then
+        return 1
+    fi
+    printf -v "$__dec_name" '%s' "$__dec_plain"

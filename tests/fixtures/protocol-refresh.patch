+# 中英双语内联文案：按当前语言二选一。msg() 的映射表所在模块已接近行数上限，
+# 新增功能的文案改用本助手在调用点成对给出，保证两种语言始终同时存在。
+# Usage: t2 "中文" "English"
+t2() {
+    if [[ "${CURRENT_LANG:-zh}" == "en" ]]; then
+        printf '%s' "$2"
+    else
+        printf '%s' "$1"
+    fi
+}

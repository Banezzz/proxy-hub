+sni_bulk_asn() {
+    (( $# > 0 )) || return 1
+    local raw
+    raw=$( { printf 'begin\nnoheader\n'; printf '%s\n' "$@"; printf 'end\n'; } | timeout 6 bash -c \
+        'exec 3<>/dev/tcp/whois.cymru.com/43 || exit 1; cat >&3; cat <&3' 2>/dev/null) || return 1
+    printf '%s\n' "$raw" | awk -F'|' 'NF >= 2 {
+        gsub(/[[:space:]]/, "", $1); gsub(/[[:space:]]/, "", $2)
+        if ($1 ~ /^[0-9]+$/) print $2, $1

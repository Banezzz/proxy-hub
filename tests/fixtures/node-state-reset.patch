-    SS_METHOD="" SS_PASSWORD="" ANYTLS_PASSWORD="" HY2_PASSWORD=""
+    reset_node_state
+    # 本函数按文件内容重新填充；缺失的键保持空值，因此协议类型也从空开始判断。
+    PROTOCOL_TYPE=""
